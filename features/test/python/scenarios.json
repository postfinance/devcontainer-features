{
    "install": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "./python": {
                "version": "3.9.19"
            }
        }
    },
    "install-alpha": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "./python": {
                "version": "3.15.0a1"
            }
        }
    },
    "install-system-provided": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "./python": {
                "version": "system-default"
            }
        }
    },
    "install-uv": {
        "build": {
            "dockerfile": "Dockerfile"
        },
        "features": {
            "./python": {
                "version": "system-default",
                "uvVersion": "latest",
                "uvIndexUrl": "https://pypi.org/simple",
                "uvExtraIndexUrl": "https://example.com/simple"
            }
        }
    }
}
